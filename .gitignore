# ============================================================
#  Unity 2022.3 项目 .gitignore
#  （基于 GitHub 官方 Unity.gitignore，并补充本项目缓存）
# ============================================================

# --- Unity 生成的缓存 / 构建目录（勿提交） ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# 内存捕获与录制（体积可能很大）
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 工具插件（如不需要请取消注释）
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider 自动生成插件
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- IDE / 编辑器本地配置与缓存 ---
.vs/
.vscode/
.gradle/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# CodeScene / Code Health 代码健康分析缓存
.cph/

# --- Unity 生成的 meta 文件（针对已忽略的生成物） ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity 崩溃报告
sysinfo.txt

# --- 构建产物 ---
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics 生成文件
crashlytics-build.properties

# 打包的 Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# 临时自动生成的 Android 资源
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity Analytics 生成文件
/[Aa]ssets/[Uu]nityGeneratedAssets/*
/[Aa]ssets/[Uu]nityGeneratedAssets/*.meta

# --- 系统 / 通用 ---
.DS_Store
Thumbs.db
desktop.ini
